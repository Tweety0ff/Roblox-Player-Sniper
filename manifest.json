{
   "author": "Tweety0ff",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "css": [
            "css/main.css"
         ],
         "js": [
            "js/libraries/jquery-3.6.1.min.js",
            "js/pages/content.js"
         ],
         "matches": [
            "*://*.roblox.com/games/*",
            "*://*.roblox.com/*/games/*"
         ],
         "run_at": "document_end"
      }
   ],
   "description": "Find a specific Roblox player in public servers by their avatar and join their server in one click. Pick a username, search, and get a list of servers with player avatars.",
   "host_permissions": [
      "*://*.roblox.com/games/",
      "*://*.roblox.com/*/games/",
      "https://apis.rovalra.com/*"
   ],
   "icons": {
      "128": "images/128x128.png",
      "16": "images/16x16.png",
      "32": "images/32x32.png",
      "48": "images/48x48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Roblox Server Sniper",
   "permissions": [
      "storage"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.0",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "images/*",
            "html/main.html"
         ]
      }
   ]
}